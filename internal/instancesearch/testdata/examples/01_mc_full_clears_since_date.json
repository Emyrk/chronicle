{
  "description": "Molten Core full clears that started on or after 2026-10-01.",
  "query": {
    "where": {
      "and": [
        {
          "field": "instance.name",
          "op": "=",
          "value": "Molten Core"
        },
        {
          "field": "instance.clear_time_ms",
          "op": ">",
          "value": 0
        },
        {
          "field": "instance.started_at",
          "op": ">=",
          "value": "2026-10-01T00:00:00Z"
        }
      ]
    }
  }
}
