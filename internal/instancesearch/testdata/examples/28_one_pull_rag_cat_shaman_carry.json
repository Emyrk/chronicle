{
  "title": "One-pull sub-2-minute Rag with a 95+ cat",
  "category": "Combined",
  "description": "A Molten Core run with mana and position data where Ragnaros died on the first pull in under 2 minutes with a 90+ kill-time parse vs the realm, a druid tanked trash as Bear then went Cat on Ragnaros for a 95+ DPS parse, at least two shamans did 600+ HPS on Ragnaros, and no warlock died on any boss.",
  "query": {
    "where": {
      "and": [
        {
          "field": "instance.name",
          "op": "contains",
          "value": "molten"
        },
        {
          "field": "instance.capability",
          "op": "=",
          "value": "unit-resources"
        },
        {
          "field": "instance.capability",
          "op": "=",
          "value": "unit-position"
        },
        {
          "field": "instance.kill_time_ms",
          "op": "<",
          "value": 120000,
          "bosses": [
            "Ragnaros"
          ]
        },
        {
          "field": "instance.kill_time_parse",
          "op": ">=",
          "value": 90,
          "bosses": [
            "Ragnaros"
          ],
          "parse_scope": "realm"
        },
        {
          "not": {
            "any_encounter": {
              "and": [
                {
                  "field": "encounter.name",
                  "op": "=",
                  "value": "Ragnaros"
                },
                {
                  "field": "encounter.outcome",
                  "op": "in",
                  "value": [
                    "wipe",
                    "reset"
                  ]
                }
              ]
            }
          }
        },
        {
          "any_player": {
            "and": [
              {
                "field": "player.class",
                "op": "=",
                "value": "DRUID"
              },
              {
                "field": "player.sub_spec",
                "op": "=",
                "value": "Bear",
                "on": "trash"
              },
              {
                "field": "player.sub_spec",
                "op": "=",
                "value": "Cat",
                "bosses": [
                  "Ragnaros"
                ]
              },
              {
                "field": "player.parse",
                "op": ">=",
                "value": 95,
                "bosses": [
                  "Ragnaros"
                ],
                "metric": "dps"
              }
            ]
          }
        },
        {
          "count_players": {
            "where": {
              "and": [
                {
                  "field": "player.class",
                  "op": "=",
                  "value": "SHAMAN"
                },
                {
                  "field": "player.hps",
                  "op": ">=",
                  "value": 600,
                  "bosses": [
                    "Ragnaros"
                  ]
                }
              ]
            },
            "op": ">=",
            "value": 2
          }
        },
        {
          "not": {
            "any_player": {
              "and": [
                {
                  "field": "player.class",
                  "op": "=",
                  "value": "WARLOCK"
                },
                {
                  "field": "player.deaths",
                  "op": ">=",
                  "value": 1,
                  "on": "bosses"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
