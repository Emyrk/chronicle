{
  "description": "Ragnaros kills recorded with both unit positions and unit resources (good for the 3D replay), from client logs rather than server-side logging.",
  "query": {
    "where": {
      "and": [
        {
          "field": "instance.capability",
          "op": "=",
          "value": "unit-position"
        },
        {
          "field": "instance.capability",
          "op": "=",
          "value": "unit-resources"
        },
        {
          "field": "instance.capability",
          "op": "!=",
          "value": "server-side"
        },
        {
          "any_encounter": {
            "and": [
              {
                "field": "encounter.name",
                "op": "=",
                "value": "Ragnaros"
              },
              {
                "field": "encounter.killed",
                "op": "=",
                "value": true
              }
            ]
          }
        }
      ]
    }
  }
}
