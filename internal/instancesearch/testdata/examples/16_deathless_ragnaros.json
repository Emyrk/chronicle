{
  "description": "Ragnaros killed with no player deaths on the kill.",
  "query": {
    "where": {
      "and": [
        {
          "field": "instance.kill_time_ms",
          "op": ">",
          "value": 0,
          "bosses": [
            "Ragnaros"
          ]
        },
        {
          "not": {
            "any_player": {
              "field": "player.deaths",
              "op": ">=",
              "value": 1,
              "bosses": [
                "Ragnaros"
              ]
            }
          }
        }
      ]
    }
  }
}
