{
  "description": "A druid who tanked trash as Bear but played Cat on every boss kill they were ranked on: Bear on trash, Cat on bosses, never Bear on a boss.",
  "query": {
    "where": {
      "any_player": {
        "and": [
          {
            "field": "player.sub_spec",
            "op": "=",
            "value": "Bear",
            "on": "trash"
          },
          {
            "field": "player.sub_spec",
            "op": "=",
            "value": "Cat",
            "on": "bosses"
          },
          {
            "not": {
              "field": "player.sub_spec",
              "op": "=",
              "value": "Bear",
              "on": "bosses"
            }
          }
        ]
      }
    }
  }
}
