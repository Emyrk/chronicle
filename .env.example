# Docker Compose defaults for Chronicle.
# Copy to .env to override anything locally.

SERVER=turtle
POSTGRES_DB=chronicle

CHRONICLE_ACCESS_URL=http://localhost:4000
CHRONICLE_JWT_SECRET_PEM=dev
CHRONICLE_SPICEDB_PRESHARED_KEY=chronicle-dev-key

CHRONICLE_JSON_LOGS=true
CHRONICLE_PROMETHEUS_ENABLED=false
CHRONICLE_PROMETHEUS_SHARED_KEY=
CHRONICLE_PROMETHEUS_IP_ALLOW=
CHRONICLE_PPROF_ENABLED=false

# Optional integrations
# CHRONICLE_DISCORD_CLIENT_ID=
# CHRONICLE_DISCORD_CLIENT_SECRET=
# CHRONICLE_DISCORD_BOT_TOKEN=
# CHRONICLE_GITHUB_OAUTH_CLIENT_ID=
# CHRONICLE_GITHUB_OAUTH_CLIENT_SECRET=
# CHRONICLE_RESEND_API_KEY=
# CHRONICLE_NITROPAY_SITE_ID=
# CHRONICLE_ADS_TXT_URL=
# CHRONICLE_GA_MEASUREMENT_ID=
# Local Stripe billing: run `stripe login` once, then enable the supervised listener.
# It discovers and configures the Stripe CLI webhook signing secret automatically.
# CHRONICLE_STRIPE_SECRET_KEY=sk_test_...
# CHRONICLE_STRIPE_ACCOUNT_ID=acct_...
# Each tier's prices may use a separate Stripe Product. Enable Customer Portal plan switching,
# include all six prices, prorate updates, and configure your preferred downgrade timing.
# CHRONICLE_STRIPE_HONORED_PRICE_IDS=price_honored_monthly,price_honored_annual
# CHRONICLE_STRIPE_REVERED_PRICE_IDS=price_revered_monthly,price_revered_annual
# CHRONICLE_STRIPE_EXALTED_PRICE_IDS=price_exalted_monthly,price_exalted_annual
# CHRONICLE_DEV_STRIPE_LISTEN=false
# CHRONICLE_WOWAUCTIONS_API_KEY=
# CHRONICLE_WOWAUCTIONS_BASE_URL=https://api.wowauctions.net/emyrk
