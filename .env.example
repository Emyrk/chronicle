# Docker Compose defaults for Chronicle.
# Copy to .env to override anything locally.

SERVER=turtle
POSTGRES_DB=chronicle

CHRONICLE_ACCESS_URL=http://localhost:4000
CHRONICLE_JWT_SECRET_PEM=dev
CHRONICLE_SPICEDB_PRESHARED_KEY=chronicle-dev-key

CHRONICLE_JSON_LOGS=true
CHRONICLE_PROMETHEUS_ENABLED=false
CHRONICLE_PPROF_ENABLED=false

# Optional integrations
# CHRONICLE_DISCORD_CLIENT_ID=
# CHRONICLE_DISCORD_CLIENT_SECRET=
# CHRONICLE_DISCORD_BOT_TOKEN=
# CHRONICLE_RESEND_API_KEY=
# Per-token CLI/API request limit. Set either value to 0 to disable limiting.
CHRONICLE_API_KEY_REQUESTS_PER_MINUTE=60
CHRONICLE_API_KEY_BURST=20

# CHRONICLE_WOWAUCTIONS_API_KEY=
# CHRONICLE_WOWAUCTIONS_BASE_URL=https://api.wowauctions.net/emyrk
