/** 
 * Chronicle SpiceDB Schema
 * 
 * Core authorization model for raid log management.
 */

definition user {}

// Top level site definition for site-wide overrides (administration)
definition chronicle {
  relation admin: user
  relation technical_admin: user
  // log_capable is the role we grant to all users who can create raid logs.
  // Mainly present to allow disabling an account's ability to create logs without
  // deleting them entirely.
  relation log_capable: user
  
  // view_queue allows technical admins to view the processing queue for logs.
  permission view_queue  = technical_admin
  // upload_youtube is for uploading youtube meta data to some logs
  permission upload_youtube = admin + log_capable

  permission upload_log = log_capable
  permission create_user = admin
}

definition river_queue {
  relation chronicle: chronicle

  permission access = chronicle->admin
}

definition raid_log {
  relation chronicle: chronicle
  relation owner: user
  
  // Visibility settings (only one should be set)
  relation public: user:*  
  
  // View: uploader, guild members (if guild-linked), or public
  permission view = public 

  permission reparse = chronicle->admin
  
  // Delete: uploader or guild admin
  permission delete = owner + chronicle->admin
}

definition log_instance {
  relation raid_log: raid_log
  
  // Inherit permissions from parent raid log
  permission view = raid_log->view
}
