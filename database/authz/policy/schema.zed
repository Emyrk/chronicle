/** 
 * Chronicle SpiceDB Schema
 * 
 * Core authorization model for raid log management.
 */

definition user {}

// Top level site definition for site-wide overrides (administration)
definition chronicle {
  relation technical_admin: user
  relation admin: user
  relation upload_capable: user
  relation unlisted_log_capable: user
  relation ad_free_capable: user
  relation inference_capable: user
  relation inference_debug_capable: user
  relation inference_disabled: user
  relation lua_project_author: user
  relation technical_user: user
  relation supporter: user

  // Site-wide proof grants supplement tenant-specific grants. The ban
  // overrides all submit grants but does not affect review permissions.
  relation photo_proof_submitter: user
  relation photo_proof_reviewer: user
  relation photo_proof_banned: user

  // Deprecated Stripe feature roles. Billing no longer writes them; migration 9
  // removes old relationships. Keep the relations during rollout so older
  // deployments can still read and revoke their existing grants.
  relation stripe_ad_free: user
  relation stripe_download_raw_logs: user
  relation stripe_unlisted_logs: user
  relation stripe_submit_photo_proof: user

  // Administrator-managed and Stripe-owned supporter tiers stay distinct.
  relation honored: user
  relation revered: user
  relation exalted: user
  relation stripe_honored: user
  relation stripe_revered: user
  relation stripe_exalted: user

  relation chronicle_guild_member: user
  relation chronicle_member: user // Not in discord

  // Granular roles
  relation moderate_logs: user
  relation moderate_guilds: user
  relation is_admin_users: user
  relation is_admin_queues: user
  relation is_admin_game_data: user
  relation manage_consumables: user
  relation is_admin_raid_requirements: user


  permission administer   = admin + technical_admin


  permission admin_logs      = administer + moderate_logs
  permission invalidate_logs = technical_admin
  permission can_reparse     = technical_user + moderate_logs
  permission administer_authz = technical_admin
  permission admin_layouts = administer
  permission admin_guilds = administer + moderate_guilds
  permission admin_users  = administer + is_admin_users
  permission admin_tenants = technical_admin
  permission admin_queues = technical_admin + is_admin_queues
  permission set_user_data_limit = technical_admin
  // Effective tiers combine administrator and Stripe grants without merging ownership.
  permission has_honored = honored + revered + exalted + stripe_honored + stripe_revered + stripe_exalted
  permission has_revered = revered + exalted + stripe_revered + stripe_exalted
  permission has_exalted = exalted + stripe_exalted

  permission shorter_urls = supporter + admin
  permission ad_free = ad_free_capable + supporter + stripe_ad_free + has_honored
  permission linked_characters_ad_free = has_revered
  permission uploaded_logs_ad_free = has_revered
  permission download_raw_logs = administer + moderate_logs + stripe_download_raw_logs + has_revered
  permission unlisted_logs = stripe_unlisted_logs + has_revered
  permission admin_regressions = technical_admin + is_admin_raid_requirements
  permission admin_speedrun_requirements = technical_admin + is_admin_raid_requirements

  permission upload_log = upload_capable + administer + supporter + chronicle_guild_member + chronicle_member
  permission append_log = chronicle_guild_member + chronicle_member
  permission mark_log_unlisted = unlisted_log_capable + admin_logs + unlisted_logs
  permission inference_available = inference_capable + administer
  permission debug_inference_chat = inference_debug_capable + administer
  permission use_inference_chat = inference_available - inference_disabled
  // Technical admins can manage all projects; other authors opt in explicitly.
  permission create_lua_project = lua_project_author + technical_admin
  permission create_layout = chronicle_guild_member + chronicle_member
  permission admin_world_data = technical_admin + is_admin_game_data
  permission admin_consumables = administer + manage_consumables

  permission admin_servers = technical_admin

  // A site-wide ban overrides every site-wide submission grant.
  permission submit_photo_proof = (photo_proof_submitter + stripe_submit_photo_proof + supporter + has_honored) - photo_proof_banned
  permission review_photo_proof = photo_proof_reviewer + technical_admin

  permission create_tenant_application = technical_admin + chronicle_guild_member

  permission honored_cosmetics = has_honored
  permission revered_cosmetics = has_revered
  permission exalted_cosmetics = has_exalted
}

definition cosmetic {
  relation honored: chronicle
  relation revered: chronicle
  relation exalted: chronicle

  permission use = honored->honored_cosmetics + revered->revered_cosmetics + exalted->exalted_cosmetics
}

// An upload key is on a azeroth core world server.
definition wow_server_upload_key {}

definition wow_tenant {
  relation chronicle: chronicle
  relation admin: user
  relation photo_proof_submitter: user
  relation photo_proof_reviewer: user

  permission administer = admin + chronicle->admin_tenants + chronicle->admin_tenants
  // Site-wide proof grants flow through chronicle; tenant admins do not
  // implicitly receive either proof permission.
  // Subtract after combining tenant and site-wide grants, so a ban also
  // overrides tenant grants (and future site-wide grant sources).
  permission submit_photo_proof = (photo_proof_submitter + chronicle->submit_photo_proof) - chronicle->photo_proof_banned
  permission review_photo_proof = photo_proof_reviewer + chronicle->review_photo_proof
}

definition wow_tenant_application {
  // When making an application, we auto create the linked tenant
  relation wow_tenant: wow_tenant

  // admin can manage the application
  relation admin: user

  permission administer = admin + wow_tenant->administer
}

definition wow_server {
  relation chronicle: chronicle
  relation admin: user
  relation tenant: wow_tenant

  permission upload_log = admin + chronicle->admin_servers
  permission administer = admin + chronicle->admin_servers
  permission manage_log_retention = admin + chronicle->admin_servers
}

definition wow_server_realm {
  // More than 1 realm belongs to a server
  relation wow_server: wow_server
  relation world_daemon: wow_server_upload_key

  permission administer = wow_server->administer
  permission upload_log = world_daemon + wow_server->upload_log
  permission manage_log_retention = wow_server->manage_log_retention
}

definition layout {
  relation chronicle: chronicle
  relation owner: user

  permission delete = owner + chronicle->admin_layouts
  permission edit = owner + chronicle->admin_layouts
}

// Lua projects are created by opted-in users or technical admins. Published
// channels are public by default; draft bytes require update permission.
definition lua_project {
  relation chronicle: chronicle
  relation owner: user
  // Older projects grant both view and use to everyone through public_viewer.
  relation public_viewer: user:*
  // viewer may read the addon page and source; runner may run it in a panel. New projects grant
  // both to user:*; removing them makes an addon private.
  relation viewer: user | user:*
  relation runner: user | user:*
  // Contributor grants, chosen per person by the owner: editor saves to main, publisher tags releases.
  relation editor: user
  relation publisher: user
  // Legacy grant from the unstable channel; it now counts as release. Kept so existing relationships stay valid.
  relation unstable_publisher: user

  permission manage = owner + chronicle->administer_authz
  permission edit = editor + manage
  permission release = publisher + unstable_publisher + manage
  permission view = viewer + public_viewer + edit + release
  permission use = runner + public_viewer + edit + release
  // update is the Workshop's permission: editing the working copy and its AI chat.
  permission update = edit
}

// Talent builds are always publicly viewable — no view permission needed.
// Only mutations are gated.
definition talent_build {
  relation chronicle: chronicle
  relation owner: user

  permission edit = owner + chronicle->administer
  permission delete = owner + chronicle->administer
}

// Saved raid compositions from the raid planner. Viewing is public by
// default (share links) via the public_viewer wildcard, which the owner can
// revoke. Editors can change the composition; only the owner (or site
// admins) can delete it or manage sharing.
definition raid_composition {
  relation chronicle: chronicle
  relation owner: user
  relation editor: user
  relation viewer: user
  relation public_viewer: user:*

  permission view = owner + editor + viewer + public_viewer + chronicle->administer
  permission edit = owner + editor + chronicle->administer
  permission delete = owner + chronicle->administer
  permission manage_sharing = owner + chronicle->administer
}

definition river_queue {
  relation chronicle: chronicle

  permission access = chronicle->admin_queues
}

definition guild {
  relation chronicle: chronicle
  // TODO: Add more roles
  relation leader: user
  relation member: user

  // Site guild administrators grant this wildcard relation to enable the
  // Discord bot feature for a guild.
  relation discord_bot_enabled: user:*
  
  permission direct_member = member + leader

  // manage role leader allows someone to create a guild leader here.
  permission manage_role_leader = leader + chronicle->admin_guilds
  permission admin_guild = leader + chronicle->admin_guilds
  permission add_member = leader + chronicle->admin_guilds
  permission view_chronicle_roster = member + leader + chronicle->admin_guilds
  permission use_discord_bot = discord_bot_enabled
  permission manage_discord_bot = admin_guild & discord_bot_enabled
}

definition armory_player {
  relation chronicle: chronicle
  // The user account this character is linked to. Exclusivity (at most one
  // owner) is enforced by the user_character_links table in Postgres.
  relation owner: user

  permission own = owner
  permission manage_link = owner + chronicle->admin_users
}

definition raid_log {
  relation chronicle: chronicle
  relation uploader: user

  permission view = uploader + chronicle->admin_logs
  permission mark_unlisted = chronicle->admin_logs + (uploader & chronicle->mark_log_unlisted)
  permission reparse = chronicle->admin_logs + (uploader & chronicle->can_reparse)
  permission append = chronicle->admin_logs + (uploader & chronicle->append_log)
  permission delete_files = uploader + chronicle->admin_logs
  permission upload_youtube = uploader + chronicle->admin_logs
    
  // Delete: uploader or guild admin
  permission delete = uploader + chronicle->admin_logs
}

definition instance {
  relation raid_log: raid_log
  relation public: user:*
  
  // Inherit permissions from parent raid log
  permission view = raid_log->view + public
  permission upload_youtube = raid_log->upload_youtube
}
