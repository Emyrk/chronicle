[
  {
    "id": "18_small_group_mc_or_ony",
    "title": "Small-group Molten Core or Onyxia",
    "category": "Run",
    "description": "Molten Core or Onyxia's Lair done with 30 or fewer players.",
    "where": {
      "and": [
        {
          "field": "instance.name",
          "op": "in",
          "value": [
            "Molten Core",
            "Onyxia's Lair"
          ]
        },
        {
          "field": "instance.player_count",
          "op": "\u003c=",
          "value": 30
        }
      ]
    }
  },
  {
    "id": "26_partial_zone_and_guild_name",
    "title": "Partial zone and guild names",
    "category": "Run",
    "description": "Partial, case-insensitive names: any zone containing \"molten\" by a guild whose name starts with \"alp\".",
    "where": {
      "and": [
        {
          "field": "instance.name",
          "op": "contains",
          "value": "molten"
        },
        {
          "field": "instance.guild",
          "op": "starts_with",
          "value": "alp"
        }
      ]
    }
  },
  {
    "id": "02_rag_kill_without_wipes",
    "title": "Ragnaros with no wipes",
    "category": "Bosses",
    "description": "Ragnaros was killed and never wiped on in the same run.",
    "where": {
      "and": [
        {
          "any_encounter": {
            "and": [
              {
                "field": "encounter.name",
                "op": "=",
                "value": "Ragnaros"
              },
              {
                "field": "encounter.killed",
                "op": "=",
                "value": true
              }
            ]
          }
        },
        {
          "not": {
            "any_encounter": {
              "and": [
                {
                  "field": "encounter.name",
                  "op": "=",
                  "value": "Ragnaros"
                },
                {
                  "field": "encounter.outcome",
                  "op": "=",
                  "value": "wipe"
                }
              ]
            }
          }
        }
      ]
    }
  },
  {
