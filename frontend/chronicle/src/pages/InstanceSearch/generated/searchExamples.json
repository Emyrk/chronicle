  {
    "id": "02_rag_kill_without_wipes",
    "title": "Ragnaros with no wipes",
    "category": "Bosses",
    "description": "Ragnaros was killed and never wiped on in the same run.",
    "where": {
      "and": [
        {
          "any_encounter": {
            "and": [
              {
                "field": "encounter.name",
                "op": "=",
                "value": "Ragnaros"
              },
              {
                "field": "encounter.killed",
                "op": "=",
                "value": true
              }
            ]
          }
        },
        {
          "not": {
            "any_encounter": {
              "and": [
                {
                  "field": "encounter.name",
                  "op": "=",
                  "value": "Ragnaros"
                },
                {
                  "field": "encounter.outcome",
                  "op": "=",
                  "value": "wipe"
                }
              ]
            }
          }
        }
      ]
    },
    "cost": 18
  },
