      "and": [
        {
          "field": "instance.name",
          "op": "in",
          "value": [
            "Molten Core",
            "Onyxia's Lair"
          ]
        },
        {
          "field": "instance.player_count",
          "op": "\u003c=",
          "value": 30
        }
      ]
    },
    "cost": 11
  },
  {
    "id": "26_partial_zone_and_guild_name",
