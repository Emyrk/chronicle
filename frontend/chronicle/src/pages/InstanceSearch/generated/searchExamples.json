  {
    "id": "16_deathless_ragnaros",
    "title": "Deathless Ragnaros kill",
    "category": "Bosses",
    "description": "Ragnaros killed with no player deaths on the kill.",
    "where": {
      "and": [
        {
          "field": "instance.kill_time_ms",
          "op": "\u003e",
          "value": 0,
          "bosses": [
            "Ragnaros"
          ]
        },
        {
          "not": {
            "any_player": {
              "field": "player.deaths",
              "op": "\u003e=",
              "value": 1,
              "bosses": [
                "Ragnaros"
              ]
            }
          }
        }
      ]
    }
  },
