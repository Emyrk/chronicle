        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(chronicle_discord_http_requests_total{job=~\"$job\", instance=~\"$instance\", source=~\"$source\", method=~\"$method\", status=~\"$status\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": false,
          "refId": "A",
          "instant": true
