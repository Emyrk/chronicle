        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(chronicle_api_requests_processed_total{job=~\"$job\", instance=~\"$instance\", method=~\"$method\", path=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": false,
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Current request rate",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Number of matching route and HTTP method combinations that completed at least one request during the selected range.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
